{
  "mainBranch": "main",
  "remote": "origin",
  "appDir": "tuklas",
  "staleAfterDays": 14,
  "cacheMaxAgeMinutes": 15,
  "protectMain": true,
  "hotFileMode": "ask",
  "ignoreBranches": [
    "main",
    "Conversion",
    "gh-pages",
    "dependabot/**",
    "renovate/**"
  ],
  "hotFiles": [
    "tuklas/composer.json",
    "tuklas/composer.lock",
    "tuklas/package.json",
    "tuklas/package-lock.json",
    "tuklas/client/package.json",
    "tuklas/client/vite.config.*",
    "tuklas/bootstrap/app.php",
    "tuklas/bootstrap/providers.php",
    "tuklas/routes/api.php",
    "tuklas/routes/web.php",
    "tuklas/routes/channels.php",
    "tuklas/routes/console.php",
    "tuklas/config/**",
    "tuklas/app/Providers/**",
    "tuklas/app/Models/User.php",
    "tuklas/database/seeders/DemoSeeder.php",
    "tuklas/tests/TestCase.php",
    "tuklas/client/src/App.tsx",
    "tuklas/client/src/api/client.ts",
    "tuklas/client/src/components/ui/**",
    "tuklas/client/src/components/layout/**",
    "tuklas/client/src/styles/**",
    "tuklas/phpunit.xml",
    "tuklas/phpstan.neon",
    "tuklas/pint.json",
    "tuklas/eslint.config.js",
    "tuklas/.env.example",
    "docs/TODO.md",
    ".github/**",
    ".claude/**",
    "CLAUDE.md"
  ]
}
