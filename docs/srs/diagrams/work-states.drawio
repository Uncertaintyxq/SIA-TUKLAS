rce="c3" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="Start review" style="endArrow=open;endSize=12;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=14;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="Approve &amp;amp; sign off&lt;br&gt;[every fix confirmed]" style="endArrow=open;endSize=12;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=14;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="Reject&lt;br&gt;[confirmed]" style="endArrow=open;endSize=12;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=14;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Return with&lt;br&gt;comments" style="endArrow=open;endSize=12;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=14;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;exitX=0.6;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="Revise &amp;amp;&lt;br&gt;resubmit" style="endArrow=open;endSize=12;html=1;rounded=0;labelBackgroundColor=#ffffff;fontSize=14;fontFamily=Arial;fontColor=#000000;strokeColor=#000000;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="c9" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="485" y="535"/></Array></mxGeometry></mxCell><mxCell id="c21" value="" style="endArrow=open;endSize=12;html=1;rounded=0;labelBackgroundColor=#ffff