APP_NAME=Tuklas
APP_ENV=local
APP_KEY=
# Old keys, comma-separated, so data encrypted before a key rotation can still be read
APP_PREVIOUS_KEYS=
APP_DEBUG=true
# The address people open Tuklas at. In development that's the Vite dev server, which forwards /api
# to Laravel on :8000, so emailed links (verification, password reset) work from the same origin.
APP_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Matches docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuklas
DB_USERNAME=tuklas
DB_PASSWORD=tuklas

HASH_DRIVER=argon2id

SESSION_DRIVER=database
# Minutes of inactivity before a session ends
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true in production (HTTPS only)
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Hosts the React app is served from; they get cookie sessions and CSRF protection
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000

# Live updates go through Laravel Reverb (`php artisan reverb:start`). `php artisan reverb:install`
# fills in the REVERB_* keys; use `log` to run without it.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# The React app connects with these (exposed to the browser: never put the secret here)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@tuklas.test"
MAIL_FROM_NAME="${APP_NAME}"

# Enables POST /api/demo/reset ("Reset demo data") and relaxes 2FA for the seeded demo accounts.
# The app refuses to start with this on when APP_ENV=production.
DEMO_MODE=true
