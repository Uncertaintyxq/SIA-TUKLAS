# MySQL tuned for a small server (Azure B1s, 1 GB). setup-server.sh copies this to
# /etc/mysql/mysql.conf.d/99-tuklas.cnf. On a bigger production server, raise the buffer pool.
[mysqld]
bind-address = 127.0.0.1
mysqlx = OFF
performance_schema = OFF
innodb_buffer_pool_size = 128M
innodb_log_buffer_size = 8M
max_connections = 40
table_open_cache = 400
tmp_table_size = 16M
max_heap_table_size = 16M
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
