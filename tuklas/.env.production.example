# Server .env for staging and production. setup-server.sh copies this to
# /var/www/tuklas/shared/.env and fills in every __PLACEHOLDER__ (domain, keys, database password).
# The real file never goes in git; keep a copy of APP_KEY in the team's password manager.

APP_NAME=Tuklas
# staging (demo data, DEMO_MODE allowed) or production (real data; DEMO_MODE must be false)
APP_ENV=staging
APP_KEY=__APP_KEY__
# Old keys, comma-separated, so data encrypted before a key rotation can still be read
APP_PREVIOUS_KEYS=
APP_DEBUG=false
APP_URL=__APP_URL__

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tuklas
DB_USERNAME=tuklas
DB_PASSWORD=__DB_PASSWORD__

HASH_DRIVER=argon2id

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# true once the site has its HTTPS certificate (setup-server.sh sets it)
SESSION_SECURE_COOKIE=__SECURE__
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# The site's own host name: it gets cookie sessions and CSRF protection
SANCTUM_STATEFUL_DOMAINS=__DOMAIN__

# Reverb runs on this server behind Nginx (/app/). Laravel pushes to it on 127.0.0.1:8080;
# browsers connect through the site's own address (client/src/lib/realtime.tsx).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=__REVERB_APP_ID__
REVERB_APP_KEY=__REVERB_APP_KEY__
REVERB_APP_SECRET=__REVERB_APP_SECRET__
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=__DOMAIN__
# Read by npm run build (exposed to the browser: never the secret)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Staging: emails are written to storage/logs instead of sent (demo mode skips verification).
# Production: the SMTP provider's settings, with MAIL_FROM_ADDRESS on the real domain.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@__DOMAIN__"
MAIL_FROM_NAME="${APP_NAME}"

# Staging: true (one-click demo logins, "Reset demo data"). Production: false; the app refuses
# to start otherwise. Run deploy.sh again after changing it: the client is built with it.
DEMO_MODE=true
VITE_DEMO_LOGIN="${DEMO_MODE}"

# The university's name, shown to Google Scholar on student research pages (optional; one school per
# site. If several schools share a site, leave it empty: see docs/TODO.md, "several schools")
TUKLAS_INSTITUTION=

# Nightly encrypted backups (deploy/backup.sh). The PUBLIC key only: the private key that opens
# backups is kept in the team's password manager, never on the server (deploy/README.md).
BACKUP_AGE_RECIPIENT=
# Optional off-server copy through rclone, e.g. gdrive:tuklas-backups (set up with `rclone config`)
BACKUP_RCLONE_REMOTE=
BACKUP_KEEP_DAYS=30

# Push notifications on phones and browsers (Web Push). `php artisan tuklas:vapid-keys` makes the pair;
# on a server deploy.sh adds it once. WEBPUSH_SUBJECT defaults to APP_URL.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
